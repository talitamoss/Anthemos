<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    
    <!-- Network permission for Direct chat -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- File export permissions for data sovereignty -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- The trail and live sharing (docs/anthemos-2.md, "Places"): plain GPS
         and network location, followed by a foreground service. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Hey Poly (docs/anthemos-2.md): listening for one phrase, and opening
         Speak from the background when it's heard. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Anthemos 2.0: find a contact by name and call them, after a yes -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Phone backup to the pod: contacts, texts and calls, read daily and put back on a new phone (backup/).
         Receiving texts and MMS is what the phone requires of a texting app, which Anthemos is only while
         it restores texts (backup/TextingApp.kt). -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- Anthemos 2.0: installs its own updates from anthemos.org (update/Updater.kt) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Anthemos 2.0: prompts about the day (prompts/Prompter.kt) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Anthemos 2.0: its own reminders (calendar/Reminders.kt), set again after a restart -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Anthemos 2.0: screen time and estimated sleep, only once allowed in Settings (sense/PhoneSense.kt) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Timers and alarms in the phone's Clock app (focus/ClockFocus.kt) -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Package visibility (Android 11+): text-to-speech, apps opened by name (focus/DeviceFocus.kt),
         the Clock app, and music apps' search -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Next"
        android:requestLegacyExternalStorage="true">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Next"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Opened to listen: a headset or Bluetooth button (long press),
                 the assistant (holding power), or the Listen tile. Speak starts listening. -->
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="com.anthemos.LISTEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Back from signing in to Kronk. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anthemos" android:host="kronk" />
            </intent-filter>
            <!-- Back from making a pod with Kronk (pod/PodSync.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="anthemos" android:host="pod" />
            </intent-filter>
        </activity>

        <!-- The digital assistant (voice/Assistant.kt): holding the power button
             opens Speak listening, once Anthemos is chosen under Default apps. -->
        <service
            android:name=".voice.AssistantService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/assistant" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name=".voice.AssistantSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service
            android:name=".voice.AssistantRecognition"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>
        <!-- The Listen tile in Quick Settings (voice/ListenTile.kt). -->
        <service
            android:name=".voice.ListenTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_listen"
            android:label="Listen"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".place.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <service
            android:name=".voice.WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <receiver android:name=".voice.WakeOnBoot" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".update.UpdateReceiver" android:exported="false" />
        <receiver android:name=".prompts.PromptActionReceiver" android:exported="false" />
        <receiver android:name=".calendar.ReminderReceiver" android:exported="false" />
        <receiver android:name=".calendar.RemindersOnBoot" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Phone backup: the parts a texting app must have, switched on only while restoring texts (backup/TextingApp.kt) -->
        <receiver android:name=".backup.TextArrived" android:exported="true" android:enabled="false"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>
        <receiver android:name=".backup.MmsArrived" android:exported="true" android:enabled="false"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>
        <service android:name=".backup.ReplyByText" android:exported="true" android:enabled="false"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>
        <activity android:name=".backup.NewText" android:exported="true" android:enabled="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

	<!-- Disable default WorkManager initialization since we're using on-demand initialization -->
<provider
    android:name="androidx.startup.InitializationProvider"
    android:authorities="${applicationId}.androidx-startup"
    android:exported="false"
    tools:node="merge">
    <!-- Remove the default WorkManager initializer -->
    <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
</provider>
    </application>
</manifest>
